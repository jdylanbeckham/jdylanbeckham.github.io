---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Badge, Heading, Link, Pagination } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { slugify } from '@utils/slugify'

export const getStaticPaths = (async ({ paginate }) => {
  const projects = await getCollection('projects')

  const allTags = projects.map((project) => project.data.tags).flat()
  const uniqueTagLabels = [...new Set(allTags)].sort((a, b) =>
    a.localeCompare(b)
  )

  const uniqueTags = uniqueTagLabels.map((label) => ({
    label,
    slug: slugify(label),
  }))

  const allPaginatedPages = []

  for (const tag of uniqueTags) {
    const filteredProjects = projects.filter((project) =>
      project.data.tags.map((projectTag) => slugify(projectTag)).includes(tag.slug)
    )

    const paginatedPages = paginate(filteredProjects, {
      pageSize: 6,
      params: { tag: tag.slug },
      props: {
        currentTag: tag,
        uniqueTags,
      },
    })

    allPaginatedPages.push(...paginatedPages)
  }

  return allPaginatedPages
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'projects'>>
  currentTag: { label: string; slug: string }
  uniqueTags: { label: string; slug: string }[]
}

const { page, currentTag, uniqueTags } = Astro.props
---

<DefaultLayout
  title={`Projects - ${currentTag.label}`}
  description={`Selected projects by J. Dylan Beckham demonstrating ${currentTag.label} and related project management, operations, analytics, and technical capabilities.`}
>
  <PageHeader
    title={`Projects: ${currentTag.label}`}
    subtitle={`Showing ${page.total} project${page.total !== 1 ? 's' : ''} associated with "${currentTag.label}". <a href="/projects">View all projects</a> or explore another capability below.`}
    bgType="bordered"
    customBreadcrumbLabels={{
      [currentTag.slug]: currentTag.label,
    }}
    joinLastBreadcrumb={true}
  />

  <section class="my-16">
    <div class="container">
      <div class="mb-14">
        <Heading level="h2" size="h5" class="mb-3">
          Capabilities &amp; Topics
        </Heading>

        <div class="flex flex-wrap gap-x-4 gap-y-2">
          <Link href="/projects">
            All Projects
          </Link>

          {
            uniqueTags.map((tag) => {
              const isCurrentTag = tag.slug === currentTag.slug

              return isCurrentTag ? (
                <span class="font-bold" aria-current="page">
                  {tag.label}
                </span>
              ) : (
                <Link href={'/projects/tag/' + tag.slug}>
                  {tag.label}
                </Link>
              )
            })
          }
        </div>
      </div>

      <div class="flex flex-col gap-10">
        {
          page.data.map((project) => (
            <article class="max-w-5xl border-t pt-8">
              <div class="mb-5 flex flex-wrap gap-2">
                {project.data.tags.map((tag) => (
                  <Badge>{tag}</Badge>
                ))}
              </div>

              <h2 class="mb-5 text-3xl font-bold md:text-4xl">
                <Link href={'/projects/' + project.id}>
                  {project.data.title}
                </Link>
              </h2>

              <p class="mb-6 max-w-4xl text-lg leading-relaxed">
                {project.data.description}
              </p>

              <Link
                href={'/projects/' + project.id}
                isButton
                type="primary"
                animateOnHover
                animationType="nudge"
              >
                View Case Study
              </Link>
            </article>
          ))
        }
      </div>

      {
        page && page.lastPage > 1 && (
          <div class="mt-16 grid place-content-center">
            <Pagination
              firstPage={
                page.url.prev
                  ? `/projects/tag/${currentTag.slug}`
                  : null
              }
              previousPage={page.url.prev ? page.url.prev : null}
              nextPage={page.url.next ? page.url.next : null}
              lastPage={
                page.url.next
                  ? `/projects/tag/${currentTag.slug}/${page.lastPage}`
                  : null
              }
              currentPage={`${page.currentPage}`}
              totalPages={`${page.lastPage}`}
              ariaLabel={`${currentTag.label} projects pagination`}
            />
          </div>
        )
      }
    </div>
  </section>
</DefaultLayout>