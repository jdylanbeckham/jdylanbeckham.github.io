---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
---

<DefaultLayout
  title="Contact"
  description="Contact J. Dylan Beckham regarding project management, business analysis, operations, analytics, and related professional opportunities."
>
  <PageHeader
    title="Contact"
    subtitle="Interested in discussing a project, opportunity, or how my background might fit your organization? I’d be glad to connect."
    bgType="bordered"
  />

  <section class="container my-20">
    <div class="grid grid-cols-1 gap-16 md:grid-cols-2">
      <div class="space-content">
        <Heading level="h2">
          Let’s Connect
        </Heading>

        <p class="text-xl leading-relaxed">
          I’m interested in opportunities where project management,
          business analysis, operations, analytics, and technical
          problem-solving come together to move complex work toward
          measurable outcomes.
        </p>

        <p class="text-lg leading-relaxed">
          If you’re hiring, building a team, evaluating a project,
          or simply want to discuss my work, email is the best way
          to reach me.
        </p>

        <div class="mt-8">
          <Link
            href="mailto:contact@jdylanbeckham.com"
            isButton
            type="primary"
            animateOnHover
            animationType="boop"
          >
            Email Me
          </Link>
        </div>
      </div>

      <div class="space-content">
        <Heading level="h2">
          Contact Details
        </Heading>

        <div class="flex items-start gap-3">
          <Icon
            aria-hidden="true"
            name="lucide:mail"
            size={22}
            class="mt-1 shrink-0"
          />

          <div>
            <p class="font-bold">Email</p>

            <Link href="mailto:contact@jdylanbeckham.com">
              contact@jdylanbeckham.com
            </Link>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <Icon
            aria-hidden="true"
            name="lucide:map-pin"
            size={22}
            class="mt-1 shrink-0"
          />

          <div>
            <p class="font-bold">Location</p>
            <p>Dallas–Fort Worth, Texas</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <Icon
            aria-hidden="true"
            name="lucide:briefcase-business"
            size={22}
            class="mt-1 shrink-0"
          />

          <div>
            <p class="font-bold">Professional Focus</p>
            <p>
              Project Management • Business Analysis • Operations • Analytics
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</DefaultLayout>