---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import { Link } from 'accessible-astro-components'
---

<DefaultLayout
  title="Resume"
  description="Resume of J. Dylan Beckham — PMP-certified project professional with experience across project management, business analytics, operations, and data-driven decision support."
>
  <section class="my-24">
    <div class="container">
      <div class="mx-auto max-w-5xl">
        <p class="mb-4 text-lg font-semibold">Resume</p>

        <h1 class="mb-8 text-5xl font-bold leading-tight md:text-7xl">
          J. Dylan Beckham,
          <span class="text-gradient"> PMP</span>
        </h1>

        <p class="mb-4 text-xl">
          Dallas, Texas
        </p>

        <p class="mb-10 max-w-4xl text-xl leading-relaxed">
          PMP-certified Project Manager with experience leading projects,
          coordinating cross-functional initiatives, managing concurrent
          workstreams, and driving execution across technology-enabled
          business platforms.
        </p>

        <div class="flex flex-col gap-3 min-[500px]:flex-row">
          <Link
            href="/contact"
            isButton
            type="primary"
            animateOnHover
            animationType="boop"
          >
            Contact Me
          </Link>
        </div>
      </div>
    </div>
  </section>

  <section class="my-32">
    <div class="container">
      <div class="mx-auto max-w-5xl">
        <h2 class="mb-8 text-3xl font-bold md:text-5xl">
          Professional Summary
        </h2>

        <p class="max-w-4xl text-xl leading-relaxed">
          Skilled in project planning, stakeholder communication, data
          analytics, documentation, risk management, process improvement,
          and data-informed decision-making. Combines hands-on experience
          managing budgets exceeding $150,000 with a strong analytical
          foundation in business intelligence, KPI reporting, Python
          preprocessing and manipulation, data visualization, and Tableau.
        </p>
      </div>
    </div>
  </section>

  <section class="my-32">
    <div class="container">
      <div class="mx-auto max-w-5xl">
        <h2 class="mb-8 text-3xl font-bold md:text-5xl">
          Core Competencies
        </h2>

        <div class="grid grid-cols-1 gap-x-12 gap-y-4 text-lg md:grid-cols-2">
          <p>Project Coordination &amp; Operations Support</p>
          <p>Data Analysis</p>
          <p>Data Cleaning &amp; Preprocessing</p>
          <p>Data Visualization &amp; Dashboard Development</p>
          <p>KPI Tracking &amp; Operational Reporting</p>
          <p>Requirements Gathering &amp; Documentation</p>
          <p>Process Analysis &amp; Optimization</p>
          <p>Inventory Analysis &amp; Forecasting</p>
          <p>Pricing &amp; Revenue Analysis</p>
          <p>Risk Analysis</p>
          <p>Stakeholder Communication</p>
          <p>Cross-Functional Coordination</p>
          <p>Data Validation &amp; Reconciliation</p>
          <p>Platform Analytics</p>
          <p>Documentation &amp; Audit Readiness</p>
        </div>
      </div>
    </div>
  </section>

  <section class="my-32">
    <div class="container">
      <div class="mx-auto max-w-5xl">
        <h2 class="mb-10 text-3xl font-bold md:text-5xl">
          Technical Skills
        </h2>

        <div class="space-y-8">
          <div>
            <h3 class="mb-3 text-2xl font-bold">Data &amp; Analytics</h3>
            <p class="text-lg leading-relaxed">
              Python (pandas, scikit-learn) • SQL • Microsoft Excel • Tableau •
              Looker Studio • Google BigQuery • Jupyter Notebook • OpenRefine
            </p>
          </div>

          <div>
            <h3 class="mb-3 text-2xl font-bold">Machine Learning</h3>
            <p class="text-lg leading-relaxed">
              Data Cleaning &amp; Preprocessing • DataFrames • Feature Engineering •
              Feature Scaling • Classification • scikit-learn Pipelines •
              Train/Test Validation • Cross-Validation • GridSearchCV •
              Model Evaluation
            </p>
          </div>

          <div>
            <h3 class="mb-3 text-2xl font-bold">Productivity &amp; Collaboration</h3>
            <p class="text-lg leading-relaxed">
              Microsoft Word • PowerPoint • Teams • Google Workspace
            </p>
          </div>

          <div>
            <h3 class="mb-3 text-2xl font-bold">Design &amp; Digital</h3>
            <p class="text-lg leading-relaxed">
              Adobe Photoshop • Illustrator • InDesign • Dreamweaver
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="my-32">
    <div class="container">
      <div class="mx-auto max-w-5xl">
        <h2 class="mb-10 text-3xl font-bold md:text-5xl">
          Certifications &amp; Additional Training
        </h2>

        <ul class="space-y-4 text-lg leading-relaxed">
          <li>
            <strong>Project Management Professional (PMP)</strong>
            — Project Management Institute
          </li>
          <li>
            <strong>Certified Associate in Project Management (CAPM)</strong>
            — Project Management Institute
          </li>
          <li>
            <strong>Undergraduate Certificate in Data Analytics</strong>
            — University of North Texas
          </li>
          <li>
            <strong>Converged Infrastructure Associate</strong>
            — VCE
          </li>
          <li>
            <strong>Part 107 Remote Pilot</strong>
            — Federal Aviation Administration
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="my-32">
    <div class="container">
      <div class="mx-auto max-w-5xl">
        <h2 class="mb-12 text-3xl font-bold md:text-5xl">
          Professional Experience
        </h2>

        <div class="space-y-16">
          <article>
            <div class="mb-6 border-t pt-6">
              <h3 class="text-2xl font-bold">
                Business Analyst
              </h3>
              <p class="text-lg font-semibold">
                Horizon Line Productions, LLC — Dallas, TX
              </p>
              <p>Jan 2021 – Present</p>
            </div>

            <ul class="list-disc space-y-4 pl-6 text-lg leading-relaxed">
              <li>
                Coordinated concurrent operational workstreams across four
                revenue-generating business platforms spanning mobility,
                hospitality, fleet management, and decentralized technology
                deployments while overseeing more than $150,000 in business assets.
              </li>

              <li>
                Managed end-to-end project lifecycles from planning and
                procurement through deployment, ongoing operations,
                maintenance, and asset retirement.
              </li>

              <li>
                Tracked operational performance, project status, and KPIs using
                pricing statistics, dashboard analytics, utilization metrics,
                financial reporting, and platform data.
              </li>

              <li>
                Identified operational risks, evaluated performance trends,
                coordinated corrective actions, and executed data-driven
                portfolio optimization and capital-recovery strategies.
              </li>
            </ul>
          </article>

          <article>
            <div class="mb-6 border-t pt-6">
              <h3 class="text-2xl font-bold">
                Project Manager
              </h3>
              <p class="text-lg font-semibold">
                Tapped Out Gaming — Dallas, TX
              </p>
              <p>Jun 2016 – Jan 2021</p>
            </div>

            <ul class="list-disc space-y-4 pl-6 text-lg leading-relaxed">
              <li>
                Planned and coordinated vending projects for regional and
                national conventions, managing scope, logistics, inventory,
                staffing priorities, contracts, and customer service.
              </li>

              <li>
                Managed inventory acquisition projects exceeding $60,000 per
                event across 20+ events per year, using market trends, pricing
                data, customer demand, and inventory turnover to support
                purchasing, margin, and cash-flow decisions.
              </li>

              <li>
                Built Excel-based VLOOKUP and pivot-table management workflows
                to support acquisition pricing, inventory reconciliation, and
                operational decision-making.
              </li>

              <li>
                Coordinated procurement, vendor setup, inventory
                transportation, and event execution while maintaining
                operational readiness under compressed timelines.
              </li>

              <li>
                Tracked performance through sales reporting, inventory
                analysis, and financial reconciliation to support forecasting,
                pricing strategy, and continuous improvement.
              </li>
            </ul>
          </article>

          <article>
            <div class="mb-6 border-t pt-6">
              <h3 class="text-2xl font-bold">
                Event Operations Leadership
              </h3>
              <p class="text-lg font-semibold">
                MomoCon, LLC &amp; DragonCon, LLC — Atlanta, GA
              </p>
              <p>May 2017 – May 2022</p>
            </div>

            <ul class="list-disc space-y-4 pl-6 text-lg leading-relaxed">
              <li>
                Led Registration and Will-Call operations for large public
                events supporting approximately 65,000–85,000 attendees.
              </li>

              <li>
                Managed teams of 30+ volunteers at peak, including onsite
                training, scheduling, real-time issue resolution, and morale
                management.
              </li>

              <li>
                Served in Director and Assistant Director roles with authority
                to resolve most access and transaction issues independently,
                escalating restricted cases through formal governance channels.
              </li>

              <li>
                Maintained operational continuity during peak influx periods,
                mitigating crowd-flow risks and resolving access or revenue
                reconciliation discrepancies.
              </li>

              <li>
                Worked with executive leadership and department heads to align
                registration systems with event operations and stakeholder needs.
              </li>
            </ul>
          </article>

          <article>
            <div class="mb-6 border-t pt-6">
              <h3 class="text-2xl font-bold">
                Location / Training Manager
              </h3>
              <p class="text-lg font-semibold">
                Suicide Kings Entertainment — Atlanta, GA
              </p>
              <p>Jan 2012 – Jul 2014</p>
            </div>

            <ul class="list-disc space-y-4 pl-6 text-lg leading-relaxed">
              <li>
                Oversaw nine locations and 30+ employees supporting
                restaurant-based entertainment events.
              </li>

              <li>
                Helped produce average location growth of approximately 18%
                over two years.
              </li>

              <li>
                Worked with stakeholders to support marketing, revenue, and
                patron-satisfaction KPIs.
              </li>
            </ul>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="my-32">
    <div class="container">
      <div class="mx-auto max-w-5xl">
        <h2 class="mb-10 text-3xl font-bold md:text-5xl">
          Education
        </h2>

        <div class="space-y-8 text-lg leading-relaxed">
          <div>
            <h3 class="text-2xl font-bold">
              University of North Texas
            </h3>
            <p>Denton, TX</p>
          </div>

          <div>
            <p class="font-bold">
              Master of Science, Business Analytics
            </p>
            <p>Expected Graduation: December 2027</p>
          </div>

          <div>
            <p class="font-bold">
              Bachelor of Applied Arts &amp; Sciences
            </p>
            <p>
              Information Technologies, Data Analytics, &amp; Graphic Design
            </p>
            <p>GPA: 3.66</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</DefaultLayout>

<style lang="scss">
  .text-gradient {
    background: linear-gradient(
      315deg,
      light-dark(var(--color-primary-300), var(--color-secondary-100)) 25%,
      light-dark(var(--color-secondary-300), var(--color-primary-200))
    );
    background-clip: border-box;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>