---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import { Link } from 'accessible-astro-components'
---

<DefaultLayout
  title="Resume"
  description="Resume of J. Dylan Beckham — PMP-certified project professional combining project management, business analytics, operations, and data-driven decision support."
>
  <div class="resume-page">

    <!-- HERO -->
    <section class="my-24">
      <div class="container">
        <div class="mx-auto max-w-5xl">
          <p class="mb-4 text-lg font-semibold">Resume</p>

          <h1 class="mb-8 text-5xl font-bold leading-tight md:text-7xl">
            J. Dylan Beckham,
            <span class="text-gradient"> PMP</span>
          </h1>

          <p class="mb-4 text-xl">
            Dallas, Texas
          </p>

          <p class="mb-6 max-w-4xl text-xl leading-relaxed">
            PMP-certified project professional combining project management,
            business analysis, operations leadership, and analytics to bring
            structure to ambiguous objectives, establish measurable controls,
            and move complex work toward defined outcomes.
          </p>

          <p class="mb-8 max-w-4xl text-lg leading-relaxed">
            Recent University of North Texas graduate currently pursuing an
            M.S. in Business Analytics, with hands-on experience managing
            complete project lifecycles, operational workstreams, analytical
            projects, and more than $150,000 in business assets.
          </p>

          <p class="mb-8 text-lg font-semibold">
            <a
              href="/j-dylan-beckham-resume.pdf"
              download
              class="underline underline-offset-4"
            >
              Download Resume (PDF)
            </a>
          </p>

          <div class="flex flex-col gap-3 min-[500px]:flex-row">
            <Link
              href="/projects"
              isButton
              type="secondary"
              animateOnHover
              animationType="boop"
            >
              View Projects
            </Link>

            <Link
              href="/contact"
              isButton
              type="primary"
              animateOnHover
              animationType="boop"
            >
              Contact Me
            </Link>
          </div>

          <p class="mt-6 max-w-3xl text-base leading-relaxed opacity-80">
            This page provides additional professional context and project
            evidence beyond the downloadable résumé.
          </p>
        </div>
      </div>
    </section>

    <!-- PROFESSIONAL SUMMARY -->
    <section class="my-32">
      <div class="container">
        <div class="mx-auto max-w-5xl">
          <h2 class="mb-8 text-3xl font-bold md:text-5xl">
            Professional Summary
          </h2>

          <p class="max-w-4xl text-xl leading-relaxed">
            Experienced coordinating concurrent projects and operational
            workstreams, maintaining schedules and documentation, tracking
            milestones and deliverables, communicating with stakeholders and
            vendors, and translating project data, risks, and operational
            signals into actionable information. Combines project-management
            discipline with business analytics, KPI reporting, Python, SQL,
            data visualization, and process improvement to structure complex
            problems and support informed decision-making.
          </p>
        </div>
      </div>
    </section>

    <!-- SELECTED PROJECT EVIDENCE -->
    <section class="my-32">
      <div class="container">
        <div class="mx-auto max-w-5xl">
          <h2 class="mb-6 text-3xl font-bold md:text-5xl">
            Selected Project Evidence
          </h2>

          <p class="mb-10 max-w-4xl text-xl leading-relaxed">
            The portfolio expands on the résumé with detailed case studies,
            analytical outputs, project controls, technical repositories, and
            documented delivery evidence.
          </p>

          <div class="space-y-10">

            <article class="border-t pt-6">
              <h3 class="mb-2 text-2xl font-bold">
                Professional Portfolio &amp; Analytics Development (PPAD)
              </h3>

              <p class="mb-4 text-lg leading-relaxed">
                A live project-management case study demonstrating requirements
                management, scope and schedule baselines, change control, RAID
                management, Jira/GitHub execution, release management, and
                performance reporting.
              </p>

              <a
                href="/projects/ppad-project-management-case-study/"
                class="font-semibold underline underline-offset-4"
              >
                View PPAD Case Study →
              </a>
            </article>

            <article class="border-t pt-6">
              <h3 class="mb-2 text-2xl font-bold">
                IMF Reserve Analytics
              </h3>

              <p class="mb-4 text-lg leading-relaxed">
                SQL, Google BigQuery, data transformation, economic analysis,
                Tableau visualization, and reconstruction of an academic
                analytics project into a validated portfolio case study.
              </p>

              <a
                href="/projects/imf-reserve-analytics/"
                class="font-semibold underline underline-offset-4"
              >
                View IMF Reserve Analytics →
              </a>
            </article>

            <article class="border-t pt-6">
              <h3 class="mb-2 text-2xl font-bold">
                Residential Property Value Prediction
              </h3>

              <p class="mb-4 text-lg leading-relaxed">
                Python-based predictive analytics comparing linear regression,
                Bagging, Random Forest, and Gradient Boosting with
                cross-validation, model evaluation, and feature-importance
                analysis.
              </p>

              <a
                href="/projects/residential-property-value-prediction/"
                class="font-semibold underline underline-offset-4"
              >
                View Residential Property Analysis →
              </a>
            </article>

            <article class="border-t pt-6">
              <h3 class="mb-2 text-2xl font-bold">
                TCGplayer Inventory Data Reconciliation
              </h3>

              <p class="mb-4 text-lg leading-relaxed">
                Operational analytics and data-quality case study involving
                inventory reconciliation, Python/pandas, composite-key
                matching, validation logic, and business-process improvement.
              </p>

              <a
                href="/projects/"
                class="font-semibold underline underline-offset-4"
              >
                View Portfolio Projects →
              </a>
            </article>

          </div>
        </div>
      </div>
    </section>

    <!-- CORE COMPETENCIES -->
    <section class="my-32">
      <div class="container">
        <div class="mx-auto max-w-5xl">
          <h2 class="mb-8 text-3xl font-bold md:text-5xl">
            Core Competencies
          </h2>

          <div class="grid grid-cols-1 gap-x-12 gap-y-4 text-lg md:grid-cols-2">
            <p>Project Coordination &amp; Operations Support</p>
            <p>Data Analysis</p>

            <p>Data Cleaning &amp; Preprocessing</p>
            <p>Data Visualization &amp; Dashboard Development</p>

            <p>KPI Tracking &amp; Operational Reporting</p>
            <p>Requirements Gathering &amp; Documentation</p>

            <p>Process Analysis &amp; Optimization</p>
            <p>Inventory Analysis &amp; Forecasting</p>

            <p>Pricing &amp; Revenue Analysis</p>
            <p>Risk Analysis</p>

            <p>Stakeholder Communication</p>
            <p>Cross-Functional Coordination</p>

            <p>Data Validation &amp; Reconciliation</p>
            <p>Platform Analytics</p>

            <p>Documentation &amp; Audit Readiness</p>
          </div>
        </div>
      </div>
    </section>

    <!-- TECHNICAL SKILLS -->
    <section class="my-32">
      <div class="container">
        <div class="mx-auto max-w-5xl">
          <h2 class="mb-10 text-3xl font-bold md:text-5xl">
            Technical Skills
          </h2>

          <div class="space-y-8">

            <div>
              <h3 class="mb-3 text-2xl font-bold">
                Data &amp; Analytics
              </h3>

              <p class="text-lg leading-relaxed">
                Python (pandas, scikit-learn) • SQL • Microsoft Excel •
                Tableau • Looker Studio • Google BigQuery • Jupyter Notebook •
                OpenRefine
              </p>
            </div>

            <div>
              <h3 class="mb-3 text-2xl font-bold">
                Machine Learning
              </h3>

              <p class="text-lg leading-relaxed">
                Data Cleaning &amp; Preprocessing • DataFrames • Feature
                Engineering • Feature Scaling • Classification •
                scikit-learn Pipelines • Train/Test Validation •
                Cross-Validation • GridSearchCV • Model Evaluation
              </p>
            </div>

            <div>
              <h3 class="mb-3 text-2xl font-bold">
                Productivity &amp; Collaboration
              </h3>

              <p class="text-lg leading-relaxed">
                Microsoft Word • PowerPoint • Teams • Google Workspace
              </p>
            </div>

            <div>
              <h3 class="mb-3 text-2xl font-bold">
                Design &amp; Digital
              </h3>

              <p class="text-lg leading-relaxed">
                Adobe Photoshop • Illustrator • InDesign • Dreamweaver
              </p>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- CERTIFICATIONS -->
    <section class="my-32">
      <div class="container">
        <div class="mx-auto max-w-5xl">
          <h2 class="mb-10 text-3xl font-bold md:text-5xl">
            Certifications &amp; Additional Training
          </h2>

          <ul class="space-y-4 text-lg leading-relaxed">
            <li>
              <strong>Project Management Professional (PMP)</strong>
              — Project Management Institute
            </li>

            <li>
              <strong>Certified Associate in Project Management (CAPM)</strong>
              — Project Management Institute
            </li>

            <li>
              <strong>Undergraduate Certificate in Data Analytics</strong>
              — University of North Texas
            </li>

            <li>
              <strong>Converged Infrastructure Associate</strong>
              — VCE
            </li>

            <li>
              <strong>Part 107 Remote Pilot</strong>
              — Federal Aviation Administration
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- PROFESSIONAL EXPERIENCE -->
    <section class="my-32">
      <div class="container">
        <div class="mx-auto max-w-5xl">
          <h2 class="mb-12 text-3xl font-bold md:text-5xl">
            Professional Experience
          </h2>

          <div class="space-y-16">

            <!-- HORIZON LINE -->
            <article>
              <div class="mb-6 border-t pt-6">
                <h3 class="text-2xl font-bold">
                  Business Analyst
                </h3>

                <p class="text-lg font-semibold">
                  Horizon Line Productions, LLC — Dallas, TX
                </p>

                <p>Jan 2021 – Present</p>
              </div>

              <ul class="list-disc space-y-4 pl-6 text-lg leading-relaxed">
                <li>
                  Coordinated concurrent operational workstreams across four
                  revenue-generating business platforms spanning mobility,
                  hospitality, fleet management, and decentralized technology
                  deployments while overseeing more than $150,000 in business
                  assets.
                </li>

                <li>
                  Managed end-to-end project lifecycles from planning and
                  procurement through deployment, ongoing operations,
                  maintenance, and asset retirement.
                </li>

                <li>
                  Tracked operational performance, project status, and KPIs
                  using pricing statistics, dashboard analytics, utilization
                  metrics, financial reporting, and platform data.
                </li>

                <li>
                  Identified operational risks, evaluated performance trends,
                  coordinated corrective actions, and executed data-driven
                  portfolio optimization and capital-recovery strategies.
                </li>
              </ul>
            </article>

            <!-- TAPPED OUT GAMING -->
            <article>
              <div class="mb-6 border-t pt-6">
                <h3 class="text-2xl font-bold">
                  Project Manager
                </h3>

                <p class="text-lg font-semibold">
                  Tapped Out Gaming — Dallas, TX
                </p>

                <p>Jun 2016 – Jan 2021</p>
              </div>

              <ul class="list-disc space-y-4 pl-6 text-lg leading-relaxed">
                <li>
                  Planned and coordinated vending projects for regional and
                  national conventions, managing scope, logistics, inventory,
                  staffing priorities, contracts, and customer service.
                </li>

                <li>
                  Managed inventory acquisition projects exceeding $60,000 per
                  event across 20+ events per year, using market trends,
                  pricing data, customer demand, and inventory turnover to
                  support purchasing, margin, and cash-flow decisions.
                </li>

                <li>
                  Built Excel-based VLOOKUP and pivot-table management
                  workflows to support acquisition pricing, inventory
                  reconciliation, and operational decision-making.
                </li>

                <li>
                  Coordinated procurement, vendor setup, inventory
                  transportation, and event execution while maintaining
                  operational readiness under compressed timelines.
                </li>

                <li>
                  Tracked performance through sales reporting, inventory
                  analysis, and financial reconciliation to support
                  forecasting, pricing strategy, and continuous improvement.
                </li>
              </ul>
            </article>

            <!-- EVENT OPERATIONS -->
            <article>
              <div class="mb-6 border-t pt-6">
                <h3 class="text-2xl font-bold">
                  Event Operations Leadership
                </h3>

                <p class="text-lg font-semibold">
                  MomoCon, LLC &amp; DragonCon, LLC — Atlanta, GA
                </p>

                <p>May 2017 – May 2022</p>
              </div>

              <ul class="list-disc space-y-4 pl-6 text-lg leading-relaxed">
                <li>
                  Led Registration and Will-Call operations for large public
                  events supporting approximately 65,000–85,000 attendees.
                </li>

                <li>
                  Managed teams of 30+ volunteers at peak, including onsite
                  training, scheduling, real-time issue resolution, and morale
                  management.
                </li>

                <li>
                  Served in Director and Assistant Director roles with
                  authority to resolve most access and transaction issues
                  independently, escalating restricted cases through formal
                  governance channels.
                </li>

                <li>
                  Maintained operational continuity during peak influx
                  periods, mitigating crowd-flow risks and resolving access or
                  revenue reconciliation discrepancies.
                </li>

                <li>
                  Worked with executive leadership and department heads to
                  align registration systems with event operations and
                  stakeholder needs.
                </li>
              </ul>
            </article>

            <!-- SUICIDE KINGS -->
            <article>
              <div class="mb-6 border-t pt-6">
                <h3 class="text-2xl font-bold">
                  Location / Training Manager
                </h3>

                <p class="text-lg font-semibold">
                  Suicide Kings Entertainment — Atlanta, GA
                </p>

                <p>Jan 2012 – Jul 2014</p>
              </div>

              <ul class="list-disc space-y-4 pl-6 text-lg leading-relaxed">
                <li>
                  Oversaw nine locations and 30+ employees supporting
                  restaurant-based entertainment events.
                </li>

                <li>
                  Helped produce average location growth of approximately 18%
                  over two years.
                </li>

                <li>
                  Worked with stakeholders to support marketing, revenue, and
                  patron-satisfaction KPIs.
                </li>
              </ul>
            </article>

          </div>
        </div>
      </div>
    </section>

    <!-- EDUCATION -->
    <section class="my-32">
      <div class="container">
        <div class="mx-auto max-w-5xl">
          <h2 class="mb-10 text-3xl font-bold md:text-5xl">
            Education
          </h2>

          <div class="space-y-8 text-lg leading-relaxed">

            <div>
              <h3 class="text-2xl font-bold">
                University of North Texas
              </h3>
              <p>Denton, TX</p>
            </div>

            <div>
              <p class="font-bold">
                Master of Science, Business Analytics
              </p>
              <p>Expected Graduation: December 2027</p>
            </div>

            <div>
              <p class="font-bold">
                Bachelor of Applied Arts &amp; Sciences
              </p>

              <p>
                Information Technologies, Data Analytics, &amp; Graphic Design
              </p>

              <p>GPA: 3.66</p>
            </div>

          </div>
        </div>
      </div>
    </section>

  </div>
</DefaultLayout>

<style lang="scss">
  .text-gradient {
    background: linear-gradient(
      315deg,
      light-dark(var(--color-primary-300), var(--color-secondary-100)) 25%,
      light-dark(var(--color-secondary-300), var(--color-primary-200))
    );
    background-clip: border-box;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /*
   * Resume-page desktop scaling
   *
   * The case-study pages receive larger content typography through the
   * site's content styles. The Resume page uses explicit Tailwind text
   * classes, so these overrides bring its visual scale closer to the rest
   * of the portfolio on larger screens without changing mobile behavior.
   */

  @media (min-width: 1024px) {
    .resume-page :global(.max-w-5xl) {
      max-width: 72rem;
    }

    .resume-page :global(.max-w-4xl) {
      max-width: 64rem;
    }

    .resume-page :global(.max-w-3xl) {
      max-width: 56rem;
    }

    .resume-page :global(.text-base) {
      font-size: 1.0625rem;
      line-height: 1.7;
    }

    .resume-page :global(.text-lg) {
      font-size: 1.25rem;
      line-height: 1.75;
    }

    .resume-page :global(.text-xl) {
      font-size: 1.375rem;
      line-height: 1.7;
    }

    .resume-page :global(.text-2xl) {
      font-size: 1.75rem;
      line-height: 1.35;
    }

    .resume-page :global(p:not([class*='text-'])) {
      font-size: 1.125rem;
      line-height: 1.65;
    }
  }
</style>