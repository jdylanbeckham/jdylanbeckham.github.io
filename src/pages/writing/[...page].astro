---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Badge, Link } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

const featuredOrder = [
  'seven-abilities-of-exceptional-traders',
  'the-power-of-choice',
  'what-real-economics-can-teach-us-about-modern',
  'the-midas-touch',
  'rinse-repeat',
]

export const getStaticPaths = (async ({ paginate }) => {
  const writing = await getCollection('writing')

  const sortedWriting = writing.sort(
    (a, b) =>
      b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
  )

  return paginate(sortedWriting, {
    // The archive is intentionally compact enough to keep all 18 historical
    // articles on one page. This leaves room for future writing before a
    // second archive page is needed.
    pageSize: 24,
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'writing'>>
}

const { page } = Astro.props

const featuredWriting = page.data
  .filter((entry) => entry.data.featured)
  .sort((a, b) => {
    const aIndex = featuredOrder.indexOf(a.id)
    const bIndex = featuredOrder.indexOf(b.id)

    const safeA = aIndex === -1 ? Number.MAX_SAFE_INTEGER : aIndex
    const safeB = bIndex === -1 ? Number.MAX_SAFE_INTEGER : bIndex

    return safeA - safeB
  })

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
---

<DefaultLayout
  title="Writing"
  description="Published writing and archived analysis by J. Dylan Beckham on markets, business operations, project management, analytics, and decision-making."
>
  <PageHeader
    title="Writing"
    subtitle="Published analysis, professional writing, and selected archival work on markets, operations, project management, analytics, and decision-making."
    bgType="bordered"
  />

  <section class="my-16">
    <div class="container">
      <div class="writing-index-column">
        <section aria-labelledby="featured-writing-heading">
          <div class="mb-10">
            <p class="mb-2 text-sm font-bold uppercase tracking-wide">
              Selected archive
            </p>
            <h2
              id="featured-writing-heading"
              class="mb-4 text-3xl font-bold md:text-4xl"
            >
              Featured Writing
            </h2>
            <p class="max-w-4xl text-lg leading-relaxed">
              Five pieces selected for their connection to business judgment,
              economics, negotiation, valuation, risk, and repeatable
              decision-making.
            </p>
          </div>

          <div class="featured-grid">
            {
              featuredWriting.map((entry, index) => (
                <article
                  class:list={[
                    'featured-writing-card border p-6 md:p-8',
                    index === 0 && 'featured-writing-card--lead',
                  ]}
                >
                  <div class="mb-4 flex flex-wrap gap-2">
                    <Badge>{entry.data.category}</Badge>
                    {entry.data.tags.slice(0, 2).map((tag) => (
                      <Badge>{tag}</Badge>
                    ))}
                  </div>

                  <h3 class="mb-4 text-2xl font-bold md:text-3xl">
                    <Link href={'/writing/' + entry.id}>
                      {entry.data.title}
                    </Link>
                  </h3>

                  <p class="mb-3 text-sm">
                    <time
                      datetime={entry.data.publishedDate
                        .toISOString()
                        .slice(0, 10)}
                    >
                      {formatDate(entry.data.publishedDate)}
                    </time>
                    {entry.data.publication && <> · {entry.data.publication}</>}
                  </p>

                  <p class="mb-6 leading-relaxed">
                    {entry.data.description}
                  </p>

                  <Link
                    href={'/writing/' + entry.id}
                    isButton
                    type="primary"
                    animateOnHover
                    animationType="nudge"
                  >
                    Read Article
                  </Link>
                </article>
              ))
            }
          </div>
        </section>

        <section
          class="mt-20"
          aria-labelledby="quiet-speculation-archive-heading"
        >
          <div class="mb-10 border-t pt-10">
            <p class="mb-2 text-sm font-bold uppercase tracking-wide">
              Complete historical collection
            </p>
            <h2
              id="quiet-speculation-archive-heading"
              class="mb-4 text-3xl font-bold md:text-4xl"
            >
              Quiet Speculation Archive · 2013–2014
            </h2>

            <p class="max-w-4xl text-lg leading-relaxed">
              From December 2013 through April 2014, I wrote a recurring
              column for Quiet Speculation examining the economics and
              operations of the Magic: The Gathering secondary market.
              Across 18 published articles, I explored pricing, supply and
              demand, market behavior, risk, negotiation, inventory
              decisions, business planning, and repeatable buying and selling
              processes.
            </p>
          </div>

          <div class="archive-list">
            {
              page.data.map((entry) => (
                <article class="archive-row border-t py-6">
                  <div class="archive-date">
                    <time
                      datetime={entry.data.publishedDate
                        .toISOString()
                        .slice(0, 10)}
                    >
                      {formatDate(entry.data.publishedDate)}
                    </time>
                  </div>

                  <div class="archive-content">
                    <div class="mb-2 flex flex-wrap items-center gap-2">
                      <Badge>{entry.data.category}</Badge>
                      {entry.data.featured && <Badge>Featured</Badge>}
                    </div>

                    <h3 class="mb-2 text-xl font-bold md:text-2xl">
                      <Link href={'/writing/' + entry.id}>
                        {entry.data.title}
                      </Link>
                    </h3>

                    <p class="max-w-4xl leading-relaxed">
                      {entry.data.description}
                    </p>
                  </div>
                </article>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </section>
</DefaultLayout>

<style lang="scss">
  .writing-index-column {
    max-width: 1100px;
  }

  .featured-grid {
    display: grid;
    gap: var(--space-m);
  }

  .featured-writing-card {
    border-color: var(--border-color-subtle);
    border-radius: var(--radius-l);
  }

  .archive-row {
    display: grid;
    gap: var(--space-s);
  }

  .archive-date {
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .featured-writing-card--lead {
      grid-column: 1 / -1;
    }

    .archive-row {
      grid-template-columns: 150px minmax(0, 1fr);
      gap: var(--space-l);
    }
  }
</style>
