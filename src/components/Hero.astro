---
import { Link } from 'accessible-astro-components'

/**
 * Hero Component
 *
 * Primary professional positioning for the PPAD projects landing page.
 */
---

<section class="hero my-24">
  <div class="container">
    <div class="mx-auto flex max-w-5xl flex-col items-start gap-8">
      <p class="text-xl font-semibold">
        J. Dylan Beckham
      </p>

      <h1 class="text-5xl leading-tight md:text-7xl lg:text-8xl">
        Turning ambiguity into
        <span class="text-gradient"> structured, measurable outcomes.</span>
      </h1>

      <p class="max-w-4xl text-2xl leading-relaxed">
        PMP-certified project professional combining project management,
        operations, business analytics, and technical fluency to define the
        work, measure what matters, and move complex objectives toward execution.
      </p>

      <p class="text-lg font-semibold">
        Project Management • Business Analysis • Operations • Analytics
      </p>

      <div class="flex flex-col gap-3 min-[500px]:flex-row">
        <Link
          href="/projects"
          isButton
          type="primary"
          animateOnHover
          animationType="boop"
        >
          View Projects
        </Link>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  h1 {
    text-wrap: balance;
  }

  .text-gradient {
    background: linear-gradient(
      315deg,
      light-dark(var(--color-primary-300), var(--color-secondary-100)) 25%,
      light-dark(var(--color-secondary-300), var(--color-primary-200))
    );
    background-clip: border-box;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>